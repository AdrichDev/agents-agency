generator client {
  provider        = "prisma-client"
  output          = "../src/lib/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // vector sin fijar schema: funciona en Docker local (public) y en Supabase
  // (la extensión ya la crea db/01-supabase-setup.sql en `extensions`; el
  // CREATE EXTENSION IF NOT EXISTS de Prisma es no-op si ya existe).
  extensions = [vector, pgcrypto, uuidOssp(map: "uuid-ossp"), pgStatStatements(map: "pg_stat_statements"), plpgsql]
}

/// Usuarios del SaaS (login de la landing y el dashboard).
/// Phase 4: id is now a UUID equal to auth.users.id; passwordHash dropped (Supabase Auth owns credentials).
model User {
  id        String   @id @db.Uuid          // UUID = auth.users.id (Phase 4 migration)
  firstName String   @map("nombre")
  lastName  String   @map("apellido")
  email     String   @unique
  phone     String?  @map("telefono")      // aa-perfil-editable: teléfono opcional del usuario
  role      String   @default("admin") @map("rol")  // admin | editor | viewer (app-level, resolved after token verify)
  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")

  @@map("usuario")
}

/// Leads captados por el formulario de la landing pública
model LandingLead {
  id        String   @id @default(cuid())
  name      String   @map("nombre")
  email     String
  phone     String   @map("telefono")
  message   String?  @map("mensaje")        // Mensaje / comentario voluntario del lead
  consent   Boolean  @default(false) @map("consentimiento") // "He leído y acepto..."
  createdAt DateTime @default(now()) @map("creado_en")

  @@index([createdAt])
  @@map("landing_lead")
}

/// Tenant = "cliente general": el negocio que CONTRATA la plataforma (consume los
/// servicios que ofrecemos). Ancla de identidad canónica. NO confundir con `cliente`
/// (el cliente final de cada negocio, que vive en el CRM). FK en todo: tenant_id.
/// Fusión: absorbe el antiguo model Client (tabla survivor renombrada a `tenant`).
model Tenant {
  id            String   @id @default(cuid())
  codTenant     String?  @map("cod_tenant")   // ten-01, ten-02... (sin unique en DB tras fusión)
  codigo        String?  @unique @map("codigo")        // Código de negocio secuencial: cli-01, cli-02...
  name          String   @map("nombre")               // Nombre o razón social
  razonSocial   String?  @map("razon_social")          // Razón social (si difiere del nombre)
  nif           String?  @map("nif")                   // NIF / CIF
  direccion     String?  @map("direccion")             // Dirección
  email         String?  @map("email")
  phone         String?  @map("telefono")
  contactPerson String?  @map("contacto")              // Persona de contacto
  website       String?  @map("sitio_web")
  sector        String?  @map("sector")
  // Créditos de IA: el widget del cliente consume tokens de la cuenta OpenAI del propietario.
  // tokenBalance = cupo asignado; tokensUsed = consumo acumulado; isActive=false bloquea el chat.
  tokenBalance  Int      @default(0) @map("saldo_tokens")   // cupo de tokens asignado (0 = bloqueado)
  tokensUsed    Int      @default(0) @map("tokens_usados")  // consumo acumulado de tokens
  isActive      Boolean  @default(true) @map("activo")      // false → widget devuelve 402
  agents        Agent[]
  budgets       Budget[]
  prospectContacts ProspectContact[]                   // Contactos (leads/prospectos) vinculados o convertidos
  tokenUsage    TokenUsage[]                            // log de consumo por conversación
  createdAt     DateTime @default(now()) @map("creado_en")
  updatedAt     DateTime @default(now()) @updatedAt @map("actualizado_en")

  @@map("tenant")
}

/// Log de consumo de tokens por conversación (auditoría y facturación manual).
model TokenUsage {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  // agente/conversación/modelo son opcionales: el consumo desde creador_CRM
  // (operacion 'crm_generate') no tiene agente ni conversación ni modelo LLM.
  agentId        String?  @map("agente_id")
  conversationId String?  @map("conversacion_id")
  tokens         Int
  model          String?  @map("modelo")
  // Tipo de consumo (p.ej. 'crm_generate') y contexto libre del metering.
  operacion      String?  @map("operacion")
  contexto       Json?    @map("contexto")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt      DateTime @default(now()) @map("creado_en")

  @@index([tenantId, createdAt])
  @@map("uso_tokens")
}

/// Tipo de contacto comercial
enum ContactType {
  lead
  prospecto
}

/// Estado de contacto: sí / no / no contesta (nc)
enum ContactedStatus {
  si
  no
  nc
}

/// Contactos comerciales (leads y prospectos) — agenda de llamadas
model ProspectContact {
  id          String          @id @default(cuid())
  codigo      String          @unique            // Código de negocio secuencial: pc-01, pc-02...
  type        ContactType     @default(prospecto) @map("tipo")
  name        String          @map("nombre")
  phone       String?         @map("telefono")
  email       String?
  sector      String?
  direccion   String?
  peticion    String?                            // Mensaje voluntario heredado del lead (o nota manual)
  contactado  ContactedStatus @default(no)
  contactedAt DateTime?       @map("contactado_en")  // Fecha en la que se marcó como contactado
  tenant      Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  tenantId    String?         @map("tenant_id")   // Tenant al que se convirtió este contacto
  createdAt   DateTime        @default(now()) @map("creado_en")    // Fecha y hora de inclusión
  deletedAt   DateTime?       @map("eliminado_en")  // Soft delete: si está sellada, el contacto se oculta de los listados

  @@index([type, contactado])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("contacto_prospecto")
}

model Agent {
  id              String           @id @default(cuid())
  name            String           @map("nombre")
  sector          String
  systemPrompt    String           @map("prompt_sistema")
  model           String           @default("gpt-4.1-nano") @map("modelo")
  runtime         String           @default("openai") @map("motor") // openai | openclaw — F1 aa-openclaw-brain (control plane vs brain local)
  reasoningEffort String           @default("low") @map("esfuerzo_razonamiento") // minimal | low | medium | high (solo gpt-5*)
  temperature     Float            @default(0.7) @map("temperatura")
  channel         String           @default("widget") @map("canal") // widget | api | telegram | whatsapp — INFORMATIVO tras la creación: solo gatea la visibilidad de ChannelConnectPanel (telegram/whatsapp); "widget" vs "api" no tienen ninguna rama de código distinta después del alta, no asumir diferencias de comportamiento
  widgetPrimaryColor   String      @default("#4f46e5") @map("widget_color_primario")
  widgetSecondaryColor String      @default("#9333ea") @map("widget_color_secundario")
  widgetAvatarBase64   String?     @map("widget_avatar_base64") // legacy: base64 inline (coexiste)
  widgetAvatarUrl      String?     @map("widget_avatar_url")    // URL en Supabase Storage (preferida)
  widgetAvatarEmoji    String      @default("🤖") @map("widget_avatar_emoji")
  widgetTemplateConfig Json        @default("{}") @map("widget_config_plantilla")
  // F7 (aa-agent-backend-foundation): auto-verificacion de instalacion del widget.
  // `widget.js` hace un ping best-effort al cargar → el panel marca "instalado".
  widgetInstalledAt    DateTime?   @map("widget_instalado_en")   // primer ping recibido
  widgetLastSeenAt     DateTime?   @map("widget_visto_en")       // ultimo ping (ultima carga vista)
  ecommerceConfig      Json        @default("{}") @map("config_ecommerce")
  publicKey       String           @unique @default(cuid()) @map("clave_publica")
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  tenantId        String?          @map("tenant_id")
  knowledge       KnowledgeChunk[]
  skills          AgentSkill[]
  integrations    Integration[]
  automations     Automation[]
  conversations      Conversation[]
  leads              Lead[]
  channelConnections ChannelConnection[]
  services           Service[]         // Servicios reservables (consultas, demos)
  schedule           AgentSchedule?    // Horario disponible
  dataBackend        AgentDataBackend? // Backend de datos del negocio (aa-agent-backend-foundation)
  createdAt          DateTime         @default(now()) @map("creado_en")
  updatedAt          DateTime         @updatedAt @map("actualizado_en")

  @@map("agente")
}

/// Backend de datos del negocio del agente (aa-agent-backend-foundation, F1).
/// 1:1 con Agent: declara DONDE vive la data operativa (reservas, leads,
/// pedidos) y que capacidades tiene habilitadas el agente contra esa fuente.
/// v1 cablea `mode` managed_db | none_yet; `external_api` y sus campos
/// (apiBaseUrl/apiKeyEncrypted) se declaran solo por forward-compat (backlog).
/// Credenciales SIEMPRE cifradas con encryptToken/decryptToken (mismo patron
/// que tokens OAuth e Integration).
model AgentDataBackend {
  id                 String   @id @default(cuid())
  agent              Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId            String   @unique @map("agente_id")
  mode               String   @default("none_yet") @map("modo") // managed_db | external_api | none_yet
  // managed_db: connection string cifrada de la BD aprovisionada
  dbUrlEncrypted     String?  @map("db_url_cifrada")
  // v1: esquema estandar por vertical (sin mapeo por cliente) → default {}
  dbSchema           Json     @default("{}") @map("esquema_db")
  // external_api (forward-compat, NO cableado en v1)
  apiBaseUrl         String?  @map("api_base_url")
  apiKeyEncrypted    String?  @map("api_key_cifrada")
  // Subset habilitado: ["reservas", "leads", "pedidos"]
  capabilities       Json     @default("[]") @map("capacidades")
  // Destino de avisos al dueno del negocio (F6: telegram, eventos)
  notificationConfig Json     @default("{}") @map("config_notificaciones")
  createdAt          DateTime @default(now()) @map("creado_en")
  updatedAt          DateTime @updatedAt @map("actualizado_en")

  @@map("backend_datos_agente")
}

model KnowledgeChunk {
  id        String                      @id @default(cuid())
  agent     Agent                       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String                      @map("agente_id")
  source    String                      @map("fuente") // URL o nombre de documento
  content   String                      @map("contenido")
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                    @default(now()) @map("creado_en")

  @@index([agentId])
  @@map("fragmento_conocimiento")
}

/// Tipo de herramienta — solo 5 valores permitidos
enum SkillType {
  SKILL
  AGENT
  EXTENSION
  PLUGIN
  MCP
}

model Skill {
  id          String       @id @default(cuid())
  name        String       @unique @map("nombre")
  description String       @map("descripcion")
  type        SkillType    @default(SKILL) @map("tipo")
  use         String       @default("GENERAL") @map("uso") // uso funcional en UPPERCASE (EMAIL, DESARROLLO, ...) — SOLO etiqueta de catálogo/filtros UI
  // Contrato explícito skill → facultad (aa-skills-executable-contract, F1):
  // clave de TOOLS_BY_PROVIDER (gmail|slack|calendar|notion|ecommerce) → la skill
  // da tools ejecutables al agente; null = informativa (solo prompt). Se cura vía
  // PATCH /api/skills/:id/tools-provider. Migración: prisma/manual/migrate-skill-tools-provider.sql
  toolsProvider String?    @map("tools_provider")
  // Motor de instrucciones (aa-agent-skills-install-execute, F1): snapshot curado
  // del cuerpo de la skill (SKILL.md pineado en BD, nunca fetch en runtime). null =
  // sin cuerpo específico; la skill sigue instalable y ejecutable (baseline cae a
  // description/use vía usar_skill). Se cura vía PATCH /api/skills/:id/instructions.
  instructions          String?   @map("instrucciones")
  instructionsUpdatedAt DateTime? @map("instrucciones_actualizado_en")
  // Tools externas MCP curadas (aa-agent-skills-install-execute, F2b/Nivel 2):
  // servidor MCP de la skill (url + transporte http|sse). null = skill sin tools
  // MCP (sigue instalable/ejecutable a nivel instrucción). El secreto de acceso
  // NO vive aquí: es per-agente en AgentSkill.secretEncrypted (jamás global).
  mcpUrl        String?    @map("mcp_url")
  mcpTransport  String?    @map("mcp_transport")
  repoUrl     String?      @map("repo_url")
  stars       Int          @default(0) @map("estrellas")
  tools       Json         @default("[]") @map("herramientas") // [{name, description}]
  source      String       @default("github") @map("fuente") // github | builtin
  favorite    Boolean      @default(false) @map("favorito")
  agents      AgentSkill[]
  createdAt   DateTime     @default(now()) @map("creado_en")

  @@map("skill")
}

model AgentSkill {
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String @map("agente_id")
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId String @map("skill_id")
  // Secreto de acceso al servidor MCP de la skill, PER-AGENTE (F2b/Nivel 2):
  // cifrado enc:v1: (encryptToken), descifrado solo en el executor al invocar la
  // tool. Nunca un token global (anti-patrón OPERATOR_SERVICE_TOKEN): el
  // aislamiento entre agentes se garantiza por la clave compuesta agentId+skillId.
  secretEncrypted String? @map("secreto_cifrado")

  @@id([agentId, skillId])
  @@map("agente_skill")
}

model Integration {
  id           String    @id @default(cuid())
  agent        Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId      String    @map("agente_id")
  provider     String    @map("proveedor") // google | slack | notion | jira | instagram
  accessToken  String    @map("access_token")  // cifrado enc:v1:<base64>
  refreshToken String?   @map("refresh_token") // cifrado enc:v1:<base64> o null
  expiresAt    DateTime? @map("expira_en")
  status       String    @default("connected") @map("estado") // connected | reauth_required
  metadata     Json      @default("{}") @map("metadatos") // email Google, team Slack, workspace Notion, cloudId Jira
  createdAt    DateTime  @default(now()) @map("creado_en")

  @@unique([agentId, provider])
  @@map("integracion")
}

/// Integración OAuth de PLATAFORMA (aa-agenda-google-import): AA es single-tenant,
/// una sola cuenta Google (el owner). Sin agentId — distinta de `Integration`,
/// que es por-agente/tenant (cada chatbot de cliente conecta SU propio Google).
model PlatformIntegration {
  id           String    @id @default(cuid())
  provider     String    @unique @map("proveedor")
  accessToken  String    @map("access_token")  // cifrado enc:v1:<base64>
  refreshToken String?   @map("refresh_token") // cifrado enc:v1:<base64> o null
  expiresAt    DateTime? @map("expira_en")
  status       String    @default("connected") @map("estado")
  metadata     Json      @default("{}") @map("metadatos")
  createdAt    DateTime  @default(now()) @map("creado_en")

  @@map("integracion_plataforma")
}

/// Cita manual del owner en /agenda (aa-agenda-google-import): independiente
/// de Agent/Service/Appointment (esas son reservas de clientes vía widget).
/// Se sincroniza a Google (gcalEventId) si PlatformIntegration está conectada,
/// pero persiste aquí siempre — así sobrevive a un refresh o a desconectar.
model PlatformAppointment {
  id          String    @id @default(cuid())
  startAt     DateTime  @map("inicio_en")
  endAt       DateTime  @map("fin_en")
  client      String    @map("cliente")
  service     String?   @map("servicio")
  // Contacto opcional (T9): permite cruzar contra Tenant/ProspectContact para
  // construir el contactSummary del detalle (mismo patrón que booking.ts)
  email       String?   @map("email")
  phone       String?   @map("telefono")
  notes       String?   @map("notas")
  status      String    @default("Confirmada") @map("estado")
  gcalEventId String?   @map("gcal_event_id")
  createdAt   DateTime  @default(now()) @map("creado_en")
  updatedAt   DateTime  @updatedAt @map("actualizado_en")

  @@index([startAt])
  @@map("cita_agenda_plataforma")
}

model Automation {
  id        String          @id @default(cuid())
  agent     Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String          @map("agente_id")
  name      String          @map("nombre")
  trigger   String          @map("disparador") // new_email | new_slack_message | schedule
  // instrucción en lenguaje natural que ejecuta el agente, p.ej.
  // "Si el email es urgente crea un ticket en Jira y avisa por Slack"
  prompt    String
  // configuracion estructurada: { service, action, intervalMinutes }
  // base para generar workflows en n8n (jobs programados o webhooks)
  config        Json            @default("{}")
  enabled       Boolean         @default(true) @map("activa")
  lastRunAt     DateTime?       @map("ultima_ejecucion_en")
  n8nWorkflowId String?         @map("n8n_workflow_id")
  syncStatus    String          @default("pending") @map("estado_sync") // synced | pending | error
  runs          AutomationRun[]
  createdAt     DateTime        @default(now()) @map("creado_en")

  @@map("automatizacion")
}

model AutomationRun {
  id           String     @id @default(cuid())
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId String     @map("automatizacion_id")
  status       String     @map("estado") // ok | error | skipped
  summary      String?    @map("resumen")
  toolCalls    Json       @default("[]") @map("tool_calls")
  createdAt    DateTime   @default(now()) @map("creado_en")

  @@index([automationId, createdAt])
  @@map("ejecucion_automatizacion")
}

model Conversation {
  id        String    @id @default(cuid())
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String    @map("agente_id")
  channel   String    @default("widget") @map("canal")
  metadata  Json      @default("{}") @map("metadatos")
  messages  Message[]
  lead      Lead?
  createdAt DateTime  @default(now()) @map("creado_en")

  @@map("conversacion")
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String       @map("conversacion_id")
  role           String       @map("rol") // user | assistant
  content        String       @map("contenido")
  toolCalls      Json         @default("[]") @map("tool_calls")
  createdAt      DateTime     @default(now()) @map("creado_en")

  @@index([conversationId, createdAt])
  @@map("mensaje")
}

model Lead {
  id             String        @id @default(cuid())
  agent          Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId        String        @map("agente_id")
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  conversationId String?       @unique @map("conversacion_id")
  customerName   String        @map("nombre_cliente")
  email          String?
  phone          String?       @map("telefono")
  consent        Boolean       @default(false) @map("consentimiento")
  status         String        @default("new") @map("estado")
  appointments   Appointment[] // Citas agendadas
  createdAt      DateTime      @default(now()) @map("creado_en")

  @@index([agentId, createdAt])
  @@map("lead")
}

/// Auditoría de las acciones de escritura del Operator Agent (F1 aa-operator-agent).
/// Cada POST del router /service/operator deja una fila (fire-and-forget): registra
/// qué acción se ejecutó, el payload de la orden (sin secretos), el origen y el
/// resultado. Tabla aditiva — ver prisma/migrate-operator-audit.sql.
model OperatorAudit {
  id        String   @id @default(cuid())
  accion    String   @map("accion")           // tool / acción ejecutada (agencia_crear_cliente, agencia_convertir_lead, agencia_crear_agente)
  payload   Json     @default("{}") @map("payload")   // cuerpo mínimo de la orden (sin tokens ni secretos)
  origen    String   @map("origen")            // origen de la orden (telegram, widget, service-operator...)
  resultado String   @map("resultado")         // ok | error
  detalle   String?  @map("detalle")           // id del recurso creado, motivo del error o nota opcional
  createdAt DateTime @default(now()) @map("creado_en")

  @@index([createdAt])
  @@map("operator_audit")
}

model SystemConfig {
  id             String   @id @default("default")
  theme          String   @default("dark") @map("tema")
  primaryColor   String   @default("#6366f1") @map("color_primario")
  secondaryColor String   @default("#d946ef") @map("color_secundario")
  fontFamily     String   @default("ui-sans-serif, system-ui, -apple-system, sans-serif") @map("fuente")
  favicon        String?  // Almacenará la imagen en formato base64
  sidebarLogo    String?  @map("sidebar_logo") // Almacenará el logotipo en formato base64
  sidebarBg      String?  @default("#05050A") @map("sidebar_bg")
  pageBg         String?  @default("#030308") @map("page_bg")
  sidebarBgLight String?  @default("#ffffff") @map("sidebar_bg_claro")
  pageBgLight    String?  @default("#f8fafc") @map("page_bg_claro")
  adminEmail     String?  @map("email_admin") // Destinatario de las notificaciones de nuevos leads
  defaultAgentModel String @default("gpt-4.1-nano") @map("modelo_agente_default") // modelo por defecto para nuevos agentes
  reasoningEffort   String @default("low") @map("esfuerzo_razonamiento")          // effort global por defecto (gpt-5*)
  googleClientId     String? @map("google_client_id") // OAuth Google (admin) — id, no secreto
  googleClientSecret String? @map("google_client_secret") // OAuth Google (admin) — cifrado
  updatedAt      DateTime @updatedAt @map("actualizado_en")

  @@map("configuracion_sistema")
}

// ── Presupuestos ──────────────────────────────────────────────────────────────

model Budget {
  id             String       @id @default(cuid())
  quoteNumber    String       @unique @map("numero_presupuesto")  // Nº Presupuesto, ej. AD-2026-001
  tenant         Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  tenantId       String?      @map("tenant_id")
  clientSnapshot Json         @default("{}") @map("snapshot_cliente")    // Snapshot del cliente en el momento de generar
  issuerSnapshot Json         @default("{}") @map("snapshot_emisor")    // Snapshot del emisor (datos fiscales)
  status         String       @default("draft") @map("estado") // draft | sent | accepted | rejected
  subtotalImpl   Float        @default(0) @map("subtotal_impl")       // Base pago único
  subtotalMaint  Float        @default(0) @map("subtotal_mant")       // Base mensual
  vatRate        Float        @default(0.21) @map("tasa_iva")
  totalImpl      Float        @default(0) @map("total_impl")       // Con IVA
  totalMaint     Float        @default(0) @map("total_mant")       // Con IVA
  validDays      Int          @default(30) @map("dias_validez")      // Días de validez
  notes          String?      @map("notas")
  lines          BudgetLine[]
  invoice        Invoice?
  createdAt      DateTime     @default(now()) @map("creado_en")
  updatedAt      DateTime     @updatedAt @map("actualizado_en")

  @@index([tenantId, createdAt])
  @@map("presupuesto")
}

model BudgetLine {
  id          String  @id @default(cuid())
  budget      Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetId    String  @map("presupuesto_id")
  serviceId   String  @map("servicio_id")                  // id del servicio del catálogo
  name        String  @map("nombre")
  description String? @map("descripcion")
  quantity    Int     @default(1) @map("cantidad")
  implPrice   Float   @default(0) @map("precio_impl")    // Precio puesta en marcha por unidad
  maintPrice  Float   @default(0) @map("precio_mant")    // Precio mensual por unidad
  position    Int     @default(0) @map("posicion")    // Orden en la tabla

  @@index([budgetId])
  @@map("linea_presupuesto")
}

/// Factura generada automáticamente al aceptar un presupuesto (aa-facturas-desde-presupuestos-aceptados).
/// Relación 1:1 por budgetId con constraint @unique: garantiza idempotencia (no se puede
/// crear más de una factura para el mismo presupuesto, aunque el evento de aceptación se
/// reprocese). Budget sigue siendo la fuente de líneas, snapshots y totales; Invoice solo
/// guarda identidad fiscal y estado de cobro.
model Invoice {
  id        String    @id @default(cuid())
  number    String    @unique @map("numero_factura") // FAC - {derivado de quoteNumber}, ej. "FAC - 2026-001"
  budget    Budget    @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  budgetId  String    @unique @map("presupuesto_id") // unique → 1 presupuesto = máx. 1 factura
  status    String    @default("pendiente") @map("estado") // pendiente | cobrada
  paidAt    DateTime? @map("cobrado_en")
  createdAt DateTime  @default(now()) @map("creado_en")
  updatedAt DateTime  @updatedAt @map("actualizado_en")

  @@index([status])
  @@map("factura")
}

// ── Landing Builder ──────────────────────────────────────────────────────────

model LandingProject {
  id               String   @id @default(cuid())
  name             String   @map("nombre")
  business         String?  @map("negocio")
  answers          Json     @default("{}") @map("respuestas")
  chatMessages     Json     @default("[]") @map("chat_mensajes")      // [{role: user|assistant, content: string}]
  generationPrompt String?  @map("prompt_generacion")
  dbProvider       String   @default("none") @map("db_provider")   // none | local-postgres | firebase | supabase
  files            Json     @default("{}") @map("archivos")      // { path → content }
  mobileFiles      Json     @default("{}") @map("archivos_movil")      // { path → content }
  mobileStack      String?  @map("stack_movil")                      // expo | flutter
  qrUrl            String?  @map("qr_url")                      // URL editable a la que apunta el QR
  status           String   @default("draft") @map("estado")   // draft | generated
  createdAt        DateTime @default(now()) @map("creado_en")
  updatedAt        DateTime @updatedAt @map("actualizado_en")

  @@index([updatedAt])
  @@map("landing_project")
}

// ── Estudios de Mercado ───────────────────────────────────────────────────────

model MarketStudy {
  id           String   @id @default(cuid())
  title        String   @map("titulo")
  inputs       Json     @default("{}") @map("entradas")
  sections     Json     @default("[]") @map("secciones")
  prospects    Json     @default("[]") @map("prospectos")
  status       String   @default("draft") @map("estado")  // draft | generating | ready | error
  successScore Int?     @map("puntuacion_exito")                         // 1-5, null until generated or set
  model        String   @default("gpt-4.1-nano") @map("modelo") // modelo LLM para generar el estudio
  reasoningEffort String @default("low") @map("esfuerzo_razonamiento")         // effort (solo gpt-5*)
  createdAt    DateTime @default(now()) @map("creado_en")
  updatedAt    DateTime @updatedAt @map("actualizado_en")

  @@index([createdAt])
  @@map("estudio_mercado")
}

// ── Canales de mensajería (Telegram / WhatsApp) ──────────────────────────────

model ChannelConnection {
  id            String   @id @default(cuid())
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId       String   @map("agente_id")
  provider      String   @map("proveedor") // telegram | whatsapp
  credentials   Json     @map("credenciales") // ciphertext AES-256-GCM: { iv, authTag, data } — NUNCA texto plano
  status        String   @default("pending") @map("estado") // pending | active | error
  statusDetail  String?  @map("detalle_estado") // detalle del error si status=error
  webhookSecret String?  @map("webhook_secret") // Telegram: secret_token del setWebhook (≥32 bytes hex)
  botUsername   String?  @map("bot_username") // Telegram: nombre de usuario del bot (para mostrar en UI)
  botName       String?  @map("bot_nombre") // Telegram: nombre del bot
  metadata      Json     @default("{}") @map("metadata") // F2 aa-openclaw-brain: { managedBy?: "openclaw" } — si managedBy="openclaw" AA NUNCA registra webhook (OpenClaw hace polling; ver lib/openclaw/provision.ts)
  createdAt     DateTime @default(now()) @map("creado_en")
  updatedAt     DateTime @updatedAt @map("actualizado_en")

  @@unique([agentId, provider])
  @@map("conexion_canal")
}

// ── Booking / Disponibilidad ─────────────────────────────────────────────────

model Service {
  id          String    @id @default(cuid())
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId     String    @map("agente_id")
  name        String    @map("nombre") // "Consulta 30 min", "Demo 1h"
  duration    Int       @map("duracion") // duración en minutos
  description String?   @map("descripcion")
  enabled     Boolean   @default(true) @map("activo")
  slots       TimeSlot[]
  appointments Appointment[]
  createdAt   DateTime  @default(now()) @map("creado_en")
  updatedAt   DateTime  @updatedAt @map("actualizado_en")

  @@unique([agentId, name])
  @@index([agentId])
  @@map("servicio_agente")
}

model TimeSlot {
  id          String      @id @default(cuid())
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId   String      @map("servicio_id")
  startTime   DateTime    @map("inicio") // fecha + hora (ej 2026-06-20 14:30)
  endTime     DateTime    @map("fin") // fecha + hora (ej 2026-06-20 15:00)
  available   Boolean     @default(true) @map("disponible")
  appointment Appointment?
  syncedToGcal String?    @map("sincronizado_gcal") // Google Calendar event ID si sincronizado
  createdAt   DateTime    @default(now()) @map("creado_en")

  @@unique([serviceId, startTime])
  @@index([serviceId, available])
  @@index([startTime])
  @@map("franja_horaria")
}

model AgentSchedule {
  id        String   @id @default(cuid())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String   @unique @map("agente_id")
  timezone  String   @default("Europe/Madrid") @map("zona_horaria")
  // schedule = { mon: "09:00-18:00", tue: "09:00-18:00", ... }
  // o { mon: "09:00-13:00|14:00-18:00" } para descansos
  schedule  Json     @default("{}") @map("horario")
  blocked   BlockedRange[]
  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")

  @@map("horario_agente")
}

model BlockedRange {
  id        String   @id @default(cuid())
  schedule  AgentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduleId String   @map("horario_id")
  startDate DateTime  @map("fecha_inicio") // fecha inicio (sin hora, mediodía)
  endDate   DateTime  @map("fecha_fin") // fecha fin (sin hora, mediodía)
  reason    String?   @map("motivo") // "Vacaciones", "Cierre", etc.
  createdAt DateTime  @default(now()) @map("creado_en")

  @@index([scheduleId, startDate])
  @@map("rango_bloqueo")
}

model Appointment {
  id          String      @id @default(cuid())
  slot        TimeSlot    @relation(fields: [slotId], references: [id], onDelete: Restrict)
  slotId      String      @unique @map("franja_id")
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceId   String      @map("servicio_id")
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId      String?     @map("lead_id")
  email       String?     // email del lead/cliente si no vinculado
  phone       String?     @map("telefono") // teléfono del lead/cliente
  notes       String?     @map("notas") // notas de la cita
  status      String      @default("scheduled") @map("estado") // scheduled | attended | cancelled | no-show
  gcalEventId String?     @map("gcal_event_id") // Google Calendar event ID
  createdAt   DateTime    @default(now()) @map("creado_en")
  updatedAt   DateTime    @updatedAt @map("actualizado_en")

  @@index([slotId])
  @@index([leadId])
  @@index([createdAt])
  @@map("cita")
}
