generator client {
  provider        = "prisma-client"
  output          = "../src/lib/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // vector sin fijar schema: funciona en Docker local (public) y en Supabase
  // (la extensión ya la crea db/01-supabase-setup.sql en `extensions`; el
  // CREATE EXTENSION IF NOT EXISTS de Prisma es no-op si ya existe).
  extensions = [vector, pgcrypto, uuidOssp(map: "uuid-ossp"), pgStatStatements(map: "pg_stat_statements"), plpgsql]
}

/// Usuarios del SaaS (login de la landing y el dashboard).
/// Phase 4: id is now a UUID equal to auth.users.id; passwordHash dropped (Supabase Auth owns credentials).
model User {
  id        String   @id @db.Uuid // UUID = auth.users.id (Phase 4 migration)
  firstName String   @map("nombre")
  lastName  String   @map("apellido")
  email     String   @unique
  phone     String?  @map("telefono") // aa-perfil-editable: teléfono opcional del usuario
  role      String   @default("admin") @map("rol") // admin | editor | viewer | client (app-level, resolved after token verify)
  // H5 (aa-portal-cliente, T1) — Tenant al que pertenece el usuario. Es el dato del que tira la
  // puerta `clientScopeGate` para escopar todo lo que ve un `client`.
  //
  // Nullable, y eso es lo que hace la migración aditiva: `null` = usuario del estudio (staff), que es
  // exactamente el comportamiento de hoy para todas las filas existentes. Ponerlo NOT NULL exigiría
  // inventar un tenant para el staff, y un tenant inventado en la columna que decide el aislamiento
  // es la peor fila posible de esta tabla.
  //
  // Invariante de aplicación (no de esquema): `role = "client"` ⇒ `tenantId` obligatorio. No se puede
  // expresar en Prisma sin un CHECK a mano, así que lo imponen el endpoint de alta (T5) y la propia
  // puerta, que niega a un `client` sin tenant en lugar de dejarlo pasar sin filtro.
  //
  // `onDelete: Restrict` a propósito: borrar un tenant con usuarios de portal vivos tiene que fallar
  // en voz alta. Con `SetNull` esos usuarios se quedarían con `tenantId = null`, es decir,
  // convertidos en staff — un borrado de cliente que acaba en escalada de privilegios.
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")

  @@index([tenantId])
  @@map("usuario")
}

/// Leads captados por el formulario de la landing pública
model LandingLead {
  id        String   @id @default(cuid())
  name      String   @map("nombre")
  email     String
  phone     String   @map("telefono")
  message   String?  @map("mensaje") // Mensaje / comentario voluntario del lead
  consent   Boolean  @default(false) @map("consentimiento") // "He leído y acepto..."
  createdAt DateTime @default(now()) @map("creado_en")

  @@index([createdAt])
  @@map("landing_lead")
}

/// Tenant = "cliente general": el negocio que CONTRATA la plataforma (consume los
/// servicios que ofrecemos). Ancla de identidad canónica. NO confundir con `cliente`
/// (el cliente final de cada negocio, que vive en el CRM). FK en todo: tenant_id.
/// Fusión: absorbe el antiguo model Client (tabla survivor renombrada a `tenant`).
model Tenant {
  id               String                @id @default(cuid())
  codTenant        String?               @map("cod_tenant") // ten-01, ten-02... (sin unique en DB tras fusión)
  codigo           String?               @unique @map("codigo") // Código de negocio secuencial: cli-01, cli-02...
  name             String                @map("nombre") // Nombre o razón social
  razonSocial      String?               @map("razon_social") // Razón social (si difiere del nombre)
  nif              String?               @map("nif") // NIF / CIF
  direccion        String?               @map("direccion") // Dirección
  email            String?               @map("email")
  phone            String?               @map("telefono")
  contactPerson    String?               @map("contacto") // Persona de contacto
  website          String?               @map("sitio_web")
  sector           String?               @map("sector")
  // Créditos de IA: el widget del cliente consume tokens de la cuenta OpenAI del propietario.
  // tokensUsed = consumo acumulado; isActive=false bloquea el chat.
  //
  // H4 T4 — `tokenBalance` pasa a ser un OVERRIDE por tenant y por eso es nullable:
  //   número → ese es el cupo, gane lo que diga el plan (ajuste manual del propietario).
  //   0      → bloqueado a propósito. Kill switch manual, se conserva tal cual.
  //   null   → sin override: manda `plan.tokenQuotaPerAgent`, y sin plan el cupo por defecto de la
  //            plataforma (H7, `DEFAULT_TOKEN_QUOTA_PER_AGENT`). Antes de H7 esto era cupo cero, es
  //            decir, cliente nuevo bloqueado desde el primer mensaje.
  // Nullable y no "0 = sin override": 0 ya significaba BLOQUEADO y hay tenants en producción
  // puestos a 0 justo para eso. Reutilizar el 0 para "que decida el plan" convertiría el kill
  // switch manual en lo contrario de lo que hace.
  tokenBalance     Int?                  @map("saldo_tokens") // override del cupo (null = manda el plan)
  tokensUsed       Int                   @default(0) @map("tokens_usados") // consumo acumulado de tokens
  isActive         Boolean               @default(true) @map("activo") // false → widget devuelve 402
  // Periodo de facturación (H4 aa-planes-y-cuotas, T3). Un cupo que no se reinicia no es una
  // suscripción: es un prepago. `tokensUsed` se conserva como acumulado DE POR VIDA (histórico
  // que no se recalcula), y el cupo se mide contra `tokensUsedPeriod`, que vuelve a cero al
  // renovar.
  //
  // `periodAnchorDay` guarda el día de mes contratado y existe por un motivo concreto: si el
  // ancla se recalculara sólo a partir de `periodStart`, un periodo que arranca el 31 se
  // aplastaría a 28 en febrero y ya nunca volvería al 31 — deriva permanente del día de cobro.
  // Con el día guardado aparte, febrero lo clampa y marzo lo recupera.
  periodStart      DateTime              @default(now()) @map("periodo_inicio") // inicio del periodo vigente
  periodAnchorDay  Int                   @default(1) @map("periodo_dia_ancla") // 1-31, día de mes contratado
  tokensUsedPeriod Int                   @default(0) @map("tokens_usados_periodo") // consumo DEL periodo vigente
  // Modo de credenciales LLM (H2 aa-credenciales-byok-multiproveedor).
  //   platform → la plataforma pone la clave, asume el coste del LLM y lo repercute en la
  //              suscripción. El cupo de arriba es el guardarraíl de ESE coste.
  //   byok     → el cliente trae su clave (OpenAI / Gemini / Anthropic) y paga su consumo
  //              directamente al proveedor. El cupo deja de tener sentido: no hay gasto del
  //              propietario que racionar. `isActive` SÍ sigue aplicando — es el impago de la
  //              suscripción, y traer tu clave no es dejar de ser cliente.
  // Vive en el tenant y no en el agente porque es un acuerdo comercial con el cliente, y porque
  // el cupo que ramifica es del tenant (design.md §A).
  // String y no enum: el repo ya usa String + comentario + Zod en el borde para `runtime`,
  // `channel`, `reasoningEffort` y `Agent.status`.
  credentialMode   String                @default("platform") @map("modo_credencial")
  // Plan de suscripción (H4 T4). Opcional: la tabla `plan` sigue vacía y por H7 ya no hace falta
  // sembrarla — un tenant sin plan recibe el cupo por defecto de la plataforma, no cupo cero. El
  // fail-closed de H1 no se afloja: `isActive = false` y `tokenBalance = 0` siguen bloqueando.
  plan             Plan?                 @relation(fields: [planId], references: [id], onDelete: SetNull)
  planId           String?               @map("plan_id")
  // Suscripción de Stripe (H6 aa-stripe-suscripciones, T1).
  //
  // `subscriptionStatus` NO es `isActive`, y separarlos es la decisión central de H6 (design §D3).
  // Reparto estricto:
  //   isActive           → decisión HUMANA. Kill switch del propietario. Ningún webhook lo escribe.
  //   subscriptionStatus → hecho de STRIPE. Ninguna pantalla del panel lo edita.
  // Con una sola columna para los dos hechos, un `invoice.paid` reactivaría a un cliente que el
  // propietario acababa de suspender a mano: el bloqueo se desharía solo y sin dejar rastro. Es el
  // mismo error que H4/T1 deshizo al separar "cupo agotado" de "cuenta desactivada", y el que el
  // comentario de `TokenUsage.credentialMode` describe como meter dos hechos en un solo sitio.
  //
  // Valores: null | active | trialing | past_due | unpaid | canceled (los de Stripe, sin traducir).
  // `null` = SIN suscripción, y NO corta. Fail-open acotado a este campo y deliberado: los 15
  // tenants de producción no tienen suscripción, y un corte por "no consta que pague" los dejaría
  // mudos a todos el día del despliegue. El fail-closed de H1 no se afloja — `isActive` y el cupo
  // siguen cortando igual.
  // String y no enum: mismo criterio que `credentialMode`, `runtime` y `Agent.status`.
  subscriptionStatus   String? @map("estado_suscripcion")
  // Ids de Stripe. Unique porque un webhook llega identificado SÓLO por el customer/subscription y
  // hay que poder resolver el tenant sin ambigüedad: dos tenants con el mismo customer harían que un
  // cobro cambiara el estado del cliente equivocado.
  stripeCustomerId     String? @unique @map("stripe_cliente_id")
  stripeSubscriptionId String? @unique @map("stripe_suscripcion_id")
  agents           Agent[]
  budgets          Budget[]
  prospectContacts ProspectContact[] // Contactos (leads/prospectos) vinculados o convertidos
  tokenUsage       TokenUsage[] // log de consumo por conversación
  llmCredentials   TenantLlmCredential[] // claves LLM propias del cliente (modo byok)
  users            User[] // H5: usuarios de portal de este tenant (staff tiene tenantId null)
  createdAt        DateTime              @default(now()) @map("creado_en")
  updatedAt        DateTime              @default(now()) @updatedAt @map("actualizado_en")

  @@map("tenant")
}

/// Plan de suscripción (H4 aa-planes-y-cuotas, T4).
///
/// SIN NINGÚN IMPORTE, y es la decisión de diseño central de esta tabla: no hay precio, ni moneda,
/// ni tarifa. Una columna de precio aquí sería una segunda fuente de verdad para el mismo número, y
/// las dos se separan el primer día que alguien toca una y no la otra — momento en el que el panel
/// enseña una cifra, la tarjeta se carga otra, y ninguna es demostrablemente la correcta.
///
/// CORRECCIÓN (H6, design §D1): este comentario decía antes que "el importe que se cobra DE VERDAD
/// es el que está en Stripe". Acertaba en la conclusión y se equivocaba en la premisa. La FUENTE del
/// importe es `front/lib/service-catalog.json` —el mismo número se anuncia en /tarifas—, y Stripe es
/// quien lo EJECUTA: sus `Price` se siembran desde el catálogo con `npm run stripe:sync`. Que uno de
/// los dos sitios viva en un SaaS ajeno no arregla la duplicación; la empeora, porque ese se edita
/// desde un panel web sin revisión de código y sin dejar diff.
///
/// Reparto de responsabilidades: AA responde "cuántos agentes activos tiene este tenant" (un
/// entero); Stripe cobra `Price` por unidad × `quantity` = ese entero. Efecto práctico: cambiar de
/// precio es editar el catálogo y sincronizar, no una migración.
///
/// El cupo de tokens que sí vive aquí NO es el producto: es un guardarraíl anti-abuso del gasto LLM
/// del propietario. Por eso es POR AGENTE —lo que se paga por unidad se limita por unidad— y por eso
/// admite `null`: en BYOK el cliente paga su consumo a su proveedor y no hay gasto ajeno que
/// racionar, así que "sin tope" es el caso normal, no un hueco raro.
model Plan {
  id                 String   @id @default(cuid())
  codigo             String   @unique @map("codigo") // identificador estable usado por código y por H6
  nombre             String   @map("nombre")
  tokenQuotaPerAgent Int?     @map("cupo_tokens_por_agente") // por agente y periodo. null = sin tope
  isActive           Boolean  @default(true) @map("activo") // false = no asignable a tenants nuevos
  tenants            Tenant[]
  createdAt          DateTime @default(now()) @map("creado_en")
  updatedAt          DateTime @default(now()) @updatedAt @map("actualizado_en")

  @@map("plan")
}

/// Log de consumo de tokens por conversación (auditoría y facturación manual).
model TokenUsage {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  // agente/conversación/modelo son opcionales: el consumo desde creador_CRM
  // (operacion 'crm_generate') no tiene agente ni conversación ni modelo LLM.
  agentId        String?  @map("agente_id")
  conversationId String?  @map("conversacion_id")
  tokens         Int
  model          String?  @map("modelo")
  // Tipo de consumo (p.ej. 'crm_generate') y contexto libre del metering.
  operacion      String?  @map("operacion")
  contexto       Json?    @map("contexto")
  // Quién pagó ESTOS tokens (H2 aa-credenciales-byok-multiproveedor): platform | byok.
  // Sin esta columna el propietario no puede separar en su propia tabla de consumo lo que le
  // costó dinero de lo que pagó el cliente con su clave — el mismo error de meter dos hechos
  // distintos en un solo sitio que H4/T1 deshizo en `isActive`.
  credentialMode String   @default("platform") @map("modo_credencial")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt      DateTime @default(now()) @map("creado_en")

  @@index([tenantId, createdAt])
  // H4 T5 — El consumo por agente del periodo se DERIVA de esta tabla (es la fuente de verdad)
  // en vez de cachearse en una columna de `Agent`. Sin este índice la suma escanearía el
  // histórico completo del tenant en un gate que corre por mensaje.
  @@index([agentId, createdAt])
  @@map("uso_tokens")
}

/// Tipo de contacto comercial
enum ContactType {
  lead
  prospecto
}

/// Estado de contacto: sí / no / no contesta (nc)
enum ContactedStatus {
  si
  no
  nc
}

/// Contactos comerciales (leads y prospectos) — agenda de llamadas
model ProspectContact {
  id          String          @id @default(cuid())
  codigo      String          @unique // Código de negocio secuencial: pc-01, pc-02...
  type        ContactType     @default(prospecto) @map("tipo")
  name        String          @map("nombre")
  phone       String?         @map("telefono")
  email       String?
  sector      String?
  direccion   String?
  peticion    String? // Mensaje voluntario heredado del lead (o nota manual)
  contactado  ContactedStatus @default(no)
  contactedAt DateTime?       @map("contactado_en") // Fecha en la que se marcó como contactado
  tenant      Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  tenantId    String?         @map("tenant_id") // Tenant al que se convirtió este contacto
  createdAt   DateTime        @default(now()) @map("creado_en") // Fecha y hora de inclusión
  deletedAt   DateTime?       @map("eliminado_en") // Soft delete: si está sellada, el contacto se oculta de los listados

  @@index([type, contactado])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("contacto_prospecto")
}

model Agent {
  id                   String              @id @default(cuid())
  name                 String              @map("nombre")
  sector               String
  systemPrompt         String              @map("prompt_sistema")
  model                String              @default("gpt-4.1-nano") @map("modelo")
  runtime              String              @default("openai") @map("motor") // openai | openclaw — F1 aa-openclaw-brain (control plane vs brain local)
  reasoningEffort      String              @default("low") @map("esfuerzo_razonamiento") // minimal | low | medium | high (solo gpt-5*)
  temperature          Float               @default(0.7) @map("temperatura")
  channel              String              @default("widget") @map("canal") // widget | api | telegram | whatsapp — INFORMATIVO tras la creación: solo gatea la visibilidad de ChannelConnectPanel (telegram/whatsapp); "widget" vs "api" no tienen ninguna rama de código distinta después del alta, no asumir diferencias de comportamiento
  widgetPrimaryColor   String              @default("#4f46e5") @map("widget_color_primario")
  widgetSecondaryColor String              @default("#9333ea") @map("widget_color_secundario")
  widgetAvatarBase64   String?             @map("widget_avatar_base64") // legacy: base64 inline (coexiste)
  widgetAvatarUrl      String?             @map("widget_avatar_url") // URL en Supabase Storage (preferida)
  widgetAvatarEmoji    String              @default("🤖") @map("widget_avatar_emoji")
  widgetTemplateConfig Json                @default("{}") @map("widget_config_plantilla")
  // F7 (aa-agent-backend-foundation): auto-verificacion de instalacion del widget.
  // `widget.js` hace un ping best-effort al cargar → el panel marca "instalado".
  widgetInstalledAt    DateTime?           @map("widget_instalado_en") // primer ping recibido
  widgetLastSeenAt     DateTime?           @map("widget_visto_en") // ultimo ping (ultima carga vista)
  ecommerceConfig      Json                @default("{}") @map("config_ecommerce")
  // Ritmo de conversación en canales de mensajería (aa-canales-buffer-y-respuesta-partida).
  // Van en Agent y no en ChannelConnection porque son decisiones de VOZ del agente: el
  // mismo agente debe sonar igual en Telegram y en WhatsApp.
  // Los defaults reproducen el comportamiento previo al change: ningún agente ya
  // publicado cambia de conducta al aplicar la migración (AD2).
  //
  // Ventana de agrupación de mensajes entrantes, en ms. 0 = desactivado (responde a
  // cada mensaje). Recortada a INBOUND_BUFFER_MAX_MS al leer, no al guardar (AD5).
  inboundBufferMs      Int                 @default(0) @map("buffer_entrada_ms")
  // Máximo de mensajes en los que se parte una respuesta. 1 = sin partir.
  replyMaxMessages     Int                 @default(1) @map("respuesta_max_mensajes")
  // Pausa entre mensajes de una respuesta partida, en ms.
  replySplitPauseMs    Int                 @default(0) @map("respuesta_pausa_ms")
  publicKey            String              @unique @default(cuid()) @map("clave_publica")
  // Ciclo de vida (H3 aa-agente-ciclo-vida-publicacion).
  // `publicKey` existe desde el alta, así que ANTES de esto crear = publicar = facturable,
  // en el mismo instante y sin que nadie lo decidiera. `status` es quien decide ahora.
  //   draft     → no atiende tráfico real (sí la consola de operador). NO facturable.
  //   published → atiende. FACTURABLE. Sólo por acción explícita del propietario.
  //   suspended → no atiende, pero SIGUE FACTURABLE. Lo pone la plataforma (impago).
  //   archived  → retirado. No atiende, no factura. Sustituye al borrado en duro.
  // Enum de Prisma descartado a propósito: el repo ya usa String + comentario para
  // `runtime`, `channel` y `reasoningEffort`, y un enum nativo obliga a migrar el tipo en
  // Postgres por cada estado nuevo. Se valida con Zod en el borde.
  status               String              @default("draft") @map("estado")
  publishedAt          DateTime?           @map("publicado_en") // PRIMERA publicación; no se pisa al republicar
  statusChangedAt      DateTime?           @map("estado_cambiado_en") // última transición
  statusEvents         AgentStatusEvent[]
  // H4 T5 — Tope de tokens de ESTE agente por periodo, con la misma forma que el override del
  // tenant (T4): número → ese es su tope; `null` → lo dicta `plan.tokenQuotaPerAgent`.
  // Existe porque lo que se paga por unidad se limita por unidad: un tenant con tres agentes
  // tiene tres topes, no uno compartido. Sin esto, un agente puede comerse el cupo que otro ya
  // está pagando.
  tokenQuotaOverride   Int?                @map("cupo_tokens_override")
  tenant               Tenant?             @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  tenantId             String?             @map("tenant_id")
  knowledge            KnowledgeChunk[]
  skills               AgentSkill[]
  integrations         Integration[]
  automations          Automation[]
  conversations        Conversation[]
  leads                Lead[]
  channelConnections   ChannelConnection[]
  services             Service[] // Servicios reservables (consultas, demos)
  resources            Resource[] // Inventario reservable (mesas, barberos, cabinas)
  schedule             AgentSchedule? // Horario disponible
  dataBackend          AgentDataBackend? // Backend de datos del negocio (aa-agent-backend-foundation)
  createdAt            DateTime            @default(now()) @map("creado_en")
  updatedAt            DateTime            @updatedAt @map("actualizado_en")

  @@map("agente")
}

/// Rastro de cambios de estado del agente (H3 aa-agente-ciclo-vida-publicacion).
/// Sin esto no se puede responder "¿estuvo publicado en junio?", que es LA pregunta
/// de la factura: el cobro es por agente activo, y `Agent.status` sólo dice el ahora.
/// `actor` es el userId que lo hizo, o "system" cuando lo pone la plataforma
/// (suspensión por impago, que escribirá H4/H6).
model AgentStatusEvent {
  id        String   @id @default(cuid())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String   @map("agente_id")
  from      String?  @map("desde") // null en el primer evento
  to        String   @map("hasta")
  actor     String? // userId | "system"
  reason    String?  @map("motivo") // opcional: por qué (impago, retirada, …)
  createdAt DateTime @default(now()) @map("creado_en")

  @@index([agentId, createdAt])
  @@map("evento_estado_agente")
}

/// Backend de datos del negocio del agente (aa-agent-backend-foundation, F1).
/// 1:1 con Agent: declara DONDE vive la data operativa (reservas, leads,
/// pedidos) y que capacidades tiene habilitadas el agente contra esa fuente.
/// v1 cablea `mode` managed_db | none_yet; `external_api` y sus campos
/// (apiBaseUrl/apiKeyEncrypted) se declaran solo por forward-compat (backlog).
/// Credenciales SIEMPRE cifradas con encryptToken/decryptToken (mismo patron
/// que tokens OAuth e Integration).
model AgentDataBackend {
  id                 String   @id @default(cuid())
  agent              Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId            String   @unique @map("agente_id")
  mode               String   @default("none_yet") @map("modo") // managed_db | external_api | none_yet
  // managed_db: connection string cifrada de la BD aprovisionada
  dbUrlEncrypted     String?  @map("db_url_cifrada")
  // v1: esquema estandar por vertical (sin mapeo por cliente) → default {}
  dbSchema           Json     @default("{}") @map("esquema_db")
  // external_api (forward-compat, NO cableado en v1)
  apiBaseUrl         String?  @map("api_base_url")
  apiKeyEncrypted    String?  @map("api_key_cifrada")
  // Subset habilitado: ["reservas", "leads", "pedidos"]
  capabilities       Json     @default("[]") @map("capacidades")
  // Destino de avisos al dueno del negocio (F6: telegram, eventos)
  notificationConfig Json     @default("{}") @map("config_notificaciones")
  createdAt          DateTime @default(now()) @map("creado_en")
  updatedAt          DateTime @updatedAt @map("actualizado_en")

  @@map("backend_datos_agente")
}

model KnowledgeChunk {
  id        String                       @id @default(cuid())
  agent     Agent                        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String                       @map("agente_id")
  source    String                       @map("fuente") // URL o nombre de documento
  content   String                       @map("contenido")
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                     @default(now()) @map("creado_en")

  @@index([agentId])
  @@map("fragmento_conocimiento")
}

/// Tipo de herramienta — solo 5 valores permitidos
enum SkillType {
  SKILL
  AGENT
  EXTENSION
  PLUGIN
  MCP
}

model Skill {
  id                    String       @id @default(cuid())
  name                  String       @unique @map("nombre")
  description           String       @map("descripcion")
  type                  SkillType    @default(SKILL) @map("tipo")
  use                   String       @default("GENERAL") @map("uso") // uso funcional en UPPERCASE (EMAIL, DESARROLLO, ...) — SOLO etiqueta de catálogo/filtros UI
  // Contrato explícito skill → facultad (aa-skills-executable-contract, F1):
  // clave de TOOLS_BY_PROVIDER (gmail|slack|calendar|notion|ecommerce) → la skill
  // da tools ejecutables al agente; null = informativa (solo prompt). Se cura vía
  // PATCH /api/skills/:id/tools-provider. Migración: prisma/manual/migrate-skill-tools-provider.sql
  toolsProvider         String?      @map("tools_provider")
  // Motor de instrucciones (aa-agent-skills-install-execute, F1): snapshot curado
  // del cuerpo de la skill (SKILL.md pineado en BD, nunca fetch en runtime). null =
  // sin cuerpo específico; la skill sigue instalable y ejecutable (baseline cae a
  // description/use vía usar_skill). Se cura vía PATCH /api/skills/:id/instructions.
  instructions          String?      @map("instrucciones")
  instructionsUpdatedAt DateTime?    @map("instrucciones_actualizado_en")
  // Tools externas MCP curadas (aa-agent-skills-install-execute, F2b/Nivel 2):
  // servidor MCP de la skill (url + transporte http|sse). null = skill sin tools
  // MCP (sigue instalable/ejecutable a nivel instrucción). El secreto de acceso
  // NO vive aquí: es per-agente en AgentSkill.secretEncrypted (jamás global).
  mcpUrl                String?      @map("mcp_url")
  mcpTransport          String?      @map("mcp_transport")
  repoUrl               String?      @map("repo_url")
  stars                 Int          @default(0) @map("estrellas")
  tools                 Json         @default("[]") @map("herramientas") // [{name, description}]
  source                String       @default("github") @map("fuente") // github | builtin
  favorite              Boolean      @default(false) @map("favorito")
  agents                AgentSkill[]
  createdAt             DateTime     @default(now()) @map("creado_en")

  @@map("skill")
}

model AgentSkill {
  agent           Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId         String  @map("agente_id")
  skill           Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId         String  @map("skill_id")
  // Secreto de acceso al servidor MCP de la skill, PER-AGENTE (F2b/Nivel 2):
  // cifrado enc:v1: (encryptToken), descifrado solo en el executor al invocar la
  // tool. Nunca un token global (anti-patrón OPERATOR_SERVICE_TOKEN): el
  // aislamiento entre agentes se garantiza por la clave compuesta agentId+skillId.
  secretEncrypted String? @map("secreto_cifrado")

  @@id([agentId, skillId])
  @@map("agente_skill")
}

model Integration {
  id           String    @id @default(cuid())
  agent        Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId      String    @map("agente_id")
  provider     String    @map("proveedor") // google | slack | notion | jira | instagram
  accessToken  String    @map("access_token") // cifrado enc:v1:<base64>
  refreshToken String?   @map("refresh_token") // cifrado enc:v1:<base64> o null
  expiresAt    DateTime? @map("expira_en")
  status       String    @default("connected") @map("estado") // connected | reauth_required
  metadata     Json      @default("{}") @map("metadatos") // email Google, team Slack, workspace Notion, cloudId Jira
  createdAt    DateTime  @default(now()) @map("creado_en")

  @@unique([agentId, provider])
  @@map("integracion")
}

/// Clave de LLM propia del cliente (H2 aa-credenciales-byok-multiproveedor, modo `byok`).
/// Calcada de `Integration` a propósito: mismo cifrado `enc:v1:` (AES-256-GCM sobre
/// `@/lib/crypto` con `CHANNEL_ENCRYPTION_KEY`, vía `encryptToken()` en
/// `lib/integrations/oauth.ts`), mismo `@@unique([<dueño>, provider])`, mismo campo `status`.
/// No se inventa un cifrado nuevo: el que hay lleva en producción guardando tokens OAuth de
/// Google, Slack, Notion y Jira.
///
/// `apiKey` es de SÓLO ESCRITURA: no sale nunca hacia una respuesta HTTP ni hacia un log.
/// Las lecturas de la API usan un `select` explícito de los demás campos — nunca un
/// `include`, porque un `include` se trae la columna y el leak ocurre sin que nadie escriba
/// la palabra `apiKey`. Lo sostiene una prueba que afirma que el claro no aparece en el
/// cuerpo de ninguna respuesta de lectura.
///
/// `keyHint` se guarda en el `create` en vez de derivarse: el claro sólo existe en ese
/// instante, y calcularlo al leer obligaría a descifrar para pintar una lista.
model TenantLlmCredential {
  id             String    @id @default(cuid())
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       String    @map("tenant_id")
  provider       String    @map("proveedor") // openai | gemini | anthropic
  apiKey         String    @map("api_key") // cifrado enc:v1:<base64> — NUNCA en claro
  keyHint        String    @map("pista_clave") // últimos 4 caracteres, para reconocerla sin poder usarla
  // connected      → verificada contra el proveedor; es la ÚNICA con la que se sirve.
  // invalid        → el proveedor la rechazó. Se resuelve pidiéndole otra clave al cliente.
  // undecryptable  → no se puede descifrar lo que guardamos. Se resuelve revisando
  //                  CHANNEL_ENCRYPTION_KEY en el despliegue. Separado de `invalid` a propósito:
  //                  fundirlos presentaría un error de configuración del propietario como culpa
  //                  del cliente.
  status         String    @default("connected") @map("estado")
  lastVerifiedAt DateTime? @map("verificado_en")
  lastError      String?   @map("ultimo_error") // motivo del rechazo, tal cual lo dio el proveedor
  createdAt      DateTime  @default(now()) @map("creado_en")
  updatedAt      DateTime  @updatedAt @map("actualizado_en")

  @@unique([tenantId, provider])
  @@map("credencial_llm_tenant")
}

/// Integración OAuth de PLATAFORMA (aa-agenda-google-import): AA es single-tenant,
/// una sola cuenta Google (el owner). Sin agentId — distinta de `Integration`,
/// que es por-agente/tenant (cada chatbot de cliente conecta SU propio Google).
model PlatformIntegration {
  id           String    @id @default(cuid())
  provider     String    @unique @map("proveedor")
  accessToken  String    @map("access_token") // cifrado enc:v1:<base64>
  refreshToken String?   @map("refresh_token") // cifrado enc:v1:<base64> o null
  expiresAt    DateTime? @map("expira_en")
  status       String    @default("connected") @map("estado")
  metadata     Json      @default("{}") @map("metadatos")
  createdAt    DateTime  @default(now()) @map("creado_en")

  @@map("integracion_plataforma")
}

/// Cita manual del owner en /agenda (aa-agenda-google-import): independiente
/// de Agent/Service/Appointment (esas son reservas de clientes vía widget).
/// Se sincroniza a Google (gcalEventId) si PlatformIntegration está conectada,
/// pero persiste aquí siempre — así sobrevive a un refresh o a desconectar.
model PlatformAppointment {
  id          String   @id @default(cuid())
  startAt     DateTime @map("inicio_en")
  endAt       DateTime @map("fin_en")
  client      String   @map("cliente")
  service     String?  @map("servicio")
  // Contacto opcional (T9): permite cruzar contra Tenant/ProspectContact para
  // construir el contactSummary del detalle (mismo patrón que booking.ts)
  email       String?  @map("email")
  phone       String?  @map("telefono")
  notes       String?  @map("notas")
  status      String   @default("Confirmada") @map("estado")
  gcalEventId String?  @map("gcal_event_id")
  createdAt   DateTime @default(now()) @map("creado_en")
  updatedAt   DateTime @updatedAt @map("actualizado_en")

  @@index([startAt])
  @@map("cita_agenda_plataforma")
}

model Automation {
  id            String          @id @default(cuid())
  agent         Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId       String          @map("agente_id")
  name          String          @map("nombre")
  trigger       String          @map("disparador") // new_email | new_slack_message | schedule
  // instrucción en lenguaje natural que ejecuta el agente, p.ej.
  // "Si el email es urgente crea un ticket en Jira y avisa por Slack"
  prompt        String
  // configuracion estructurada: { service, action, intervalMinutes }
  // base para generar workflows en n8n (jobs programados o webhooks)
  config        Json            @default("{}")
  enabled       Boolean         @default(true) @map("activa")
  lastRunAt     DateTime?       @map("ultima_ejecucion_en")
  n8nWorkflowId String?         @map("n8n_workflow_id")
  syncStatus    String          @default("pending") @map("estado_sync") // synced | pending | error
  runs          AutomationRun[]
  createdAt     DateTime        @default(now()) @map("creado_en")

  @@map("automatizacion")
}

model AutomationRun {
  id           String     @id @default(cuid())
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId String     @map("automatizacion_id")
  status       String     @map("estado") // ok | error | skipped
  summary      String?    @map("resumen")
  toolCalls    Json       @default("[]") @map("tool_calls")
  createdAt    DateTime   @default(now()) @map("creado_en")

  @@index([automationId, createdAt])
  @@map("ejecucion_automatizacion")
}

model Conversation {
  id        String    @id @default(cuid())
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String    @map("agente_id")
  channel   String    @default("widget") @map("canal")
  metadata  Json      @default("{}") @map("metadatos")
  messages  Message[]
  lead      Lead?
  createdAt DateTime  @default(now()) @map("creado_en")
  // F1 (aa-agente-consola-pruebas, T1.2): conversación de la consola de pruebas del
  // operador. Aditivo (@default false) — regresión cero. Se excluye de los listados
  // y la analítica que ve el cliente (T1.3); el metering sigue contando (T1.2/AC6).
  isTest    Boolean   @default(false) @map("es_prueba")

  @@map("conversacion")
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String       @map("conversacion_id")
  role           String       @map("rol") // user | assistant
  content        String       @map("contenido")
  toolCalls      Json         @default("[]") @map("tool_calls")
  createdAt      DateTime     @default(now()) @map("creado_en")

  @@index([conversationId, createdAt])
  @@map("mensaje")
}

model Lead {
  id                  String        @id @default(cuid())
  agent               Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId             String        @map("agente_id")
  conversation        Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  conversationId      String?       @unique @map("conversacion_id")
  customerName        String        @map("nombre_cliente")
  email               String?
  phone               String?       @map("telefono")
  consent             Boolean       @default(false) @map("consentimiento")
  status              String        @default("new") @map("estado")
  // F2 (aa-agent-external-crm-and-lead-qualification, §C.1): calificación del
  // lead por el LLM (tool calificar_lead). Aditivo — default "unknown" para
  // filas existentes, no requiere backfill.
  qualification       String        @default("unknown") @map("calificacion") // hot | warm | cold | unknown
  qualificationReason String?       @map("motivo_calificacion")
  appointments        Appointment[] // Citas agendadas
  createdAt           DateTime      @default(now()) @map("creado_en")

  @@index([agentId, createdAt])
  @@map("lead")
}

/// Auditoría de las acciones de escritura del Operator Agent (F1 aa-operator-agent).
/// Cada POST del router /service/operator deja una fila (fire-and-forget): registra
/// qué acción se ejecutó, el payload de la orden (sin secretos), el origen y el
/// resultado. Tabla aditiva — ver prisma/migrate-operator-audit.sql.
model OperatorAudit {
  id        String   @id @default(cuid())
  accion    String   @map("accion") // tool / acción ejecutada (agencia_crear_cliente, agencia_convertir_lead, agencia_crear_agente)
  payload   Json     @default("{}") @map("payload") // cuerpo mínimo de la orden (sin tokens ni secretos)
  origen    String   @map("origen") // origen de la orden (telegram, widget, service-operator...)
  resultado String   @map("resultado") // ok | error
  detalle   String?  @map("detalle") // id del recurso creado, motivo del error o nota opcional
  createdAt DateTime @default(now()) @map("creado_en")

  @@index([createdAt])
  @@map("operator_audit")
}

model SystemConfig {
  id                 String   @id @default("default")
  theme              String   @default("dark") @map("tema")
  primaryColor       String   @default("#6366f1") @map("color_primario")
  secondaryColor     String   @default("#d946ef") @map("color_secundario")
  fontFamily         String   @default("ui-sans-serif, system-ui, -apple-system, sans-serif") @map("fuente")
  favicon            String? // Almacenará la imagen en formato base64
  sidebarLogo        String?  @map("sidebar_logo") // Almacenará el logotipo en formato base64
  sidebarBg          String?  @default("#05050A") @map("sidebar_bg")
  pageBg             String?  @default("#030308") @map("page_bg")
  sidebarBgLight     String?  @default("#ffffff") @map("sidebar_bg_claro")
  pageBgLight        String?  @default("#f8fafc") @map("page_bg_claro")
  adminEmail         String?  @map("email_admin") // Destinatario de las notificaciones de nuevos leads
  defaultAgentModel  String   @default("gpt-4.1-nano") @map("modelo_agente_default") // modelo por defecto para nuevos agentes
  reasoningEffort    String   @default("low") @map("esfuerzo_razonamiento") // effort global por defecto (gpt-5*)
  googleClientId     String?  @map("google_client_id") // OAuth Google (admin) — id, no secreto
  googleClientSecret String?  @map("google_client_secret") // OAuth Google (admin) — cifrado
  updatedAt          DateTime @updatedAt @map("actualizado_en")

  @@map("configuracion_sistema")
}

// ── Presupuestos ──────────────────────────────────────────────────────────────

model Budget {
  id             String       @id @default(cuid())
  quoteNumber    String       @unique @map("numero_presupuesto") // Nº Presupuesto, ej. AD-2026-001
  tenant         Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  tenantId       String?      @map("tenant_id")
  clientSnapshot Json         @default("{}") @map("snapshot_cliente") // Snapshot del cliente en el momento de generar
  issuerSnapshot Json         @default("{}") @map("snapshot_emisor") // Snapshot del emisor (datos fiscales)
  status         String       @default("draft") @map("estado") // draft | sent | accepted | rejected
  subtotalImpl   Float        @default(0) @map("subtotal_impl") // Base pago único
  subtotalMaint  Float        @default(0) @map("subtotal_mant") // Base mensual
  vatRate        Float        @default(0.21) @map("tasa_iva")
  totalImpl      Float        @default(0) @map("total_impl") // Con IVA
  totalMaint     Float        @default(0) @map("total_mant") // Con IVA
  validDays      Int          @default(30) @map("dias_validez") // Días de validez
  notes          String?      @map("notas")
  lines          BudgetLine[]
  invoice        Invoice?
  createdAt      DateTime     @default(now()) @map("creado_en")
  updatedAt      DateTime     @updatedAt @map("actualizado_en")

  @@index([tenantId, createdAt])
  @@map("presupuesto")
}

model BudgetLine {
  id          String  @id @default(cuid())
  budget      Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetId    String  @map("presupuesto_id")
  serviceId   String  @map("servicio_id") // id del servicio del catálogo
  name        String  @map("nombre")
  description String? @map("descripcion")
  quantity    Int     @default(1) @map("cantidad")
  implPrice   Float   @default(0) @map("precio_impl") // Precio puesta en marcha por unidad
  maintPrice  Float   @default(0) @map("precio_mant") // Precio mensual por unidad
  position    Int     @default(0) @map("posicion") // Orden en la tabla

  @@index([budgetId])
  @@map("linea_presupuesto")
}

/// Factura generada automáticamente al aceptar un presupuesto (aa-facturas-desde-presupuestos-aceptados).
/// Relación 1:1 por budgetId con constraint @unique: garantiza idempotencia (no se puede
/// crear más de una factura para el mismo presupuesto, aunque el evento de aceptación se
/// reprocese). Budget sigue siendo la fuente de líneas, snapshots y totales; Invoice solo
/// guarda identidad fiscal y estado de cobro.
model Invoice {
  id        String    @id @default(cuid())
  number    String    @unique @map("numero_factura") // FAC - {derivado de quoteNumber}, ej. "FAC - 2026-001"
  budget    Budget    @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  budgetId  String    @unique @map("presupuesto_id") // unique → 1 presupuesto = máx. 1 factura
  status    String    @default("pendiente") @map("estado") // pendiente | cobrada
  paidAt    DateTime? @map("cobrado_en")
  createdAt DateTime  @default(now()) @map("creado_en")
  updatedAt DateTime  @updatedAt @map("actualizado_en")

  @@index([status])
  @@map("factura")
}

// ── Landing Builder ──────────────────────────────────────────────────────────

model LandingProject {
  id               String   @id @default(cuid())
  name             String   @map("nombre")
  business         String?  @map("negocio")
  answers          Json     @default("{}") @map("respuestas")
  chatMessages     Json     @default("[]") @map("chat_mensajes") // [{role: user|assistant, content: string}]
  generationPrompt String?  @map("prompt_generacion")
  dbProvider       String   @default("none") @map("db_provider") // none | local-postgres | firebase | supabase
  files            Json     @default("{}") @map("archivos") // { path → content }
  mobileFiles      Json     @default("{}") @map("archivos_movil") // { path → content }
  mobileStack      String?  @map("stack_movil") // expo | flutter
  qrUrl            String?  @map("qr_url") // URL editable a la que apunta el QR
  status           String   @default("draft") @map("estado") // draft | generated
  createdAt        DateTime @default(now()) @map("creado_en")
  updatedAt        DateTime @updatedAt @map("actualizado_en")

  @@index([updatedAt])
  @@map("landing_project")
}

// ── Estudios de Mercado ───────────────────────────────────────────────────────

model MarketStudy {
  id              String   @id @default(cuid())
  title           String   @map("titulo")
  inputs          Json     @default("{}") @map("entradas")
  sections        Json     @default("[]") @map("secciones")
  prospects       Json     @default("[]") @map("prospectos")
  status          String   @default("draft") @map("estado") // draft | generating | ready | error
  successScore    Int?     @map("puntuacion_exito") // 1-5, null until generated or set
  model           String   @default("gpt-4.1-nano") @map("modelo") // modelo LLM para generar el estudio
  reasoningEffort String   @default("low") @map("esfuerzo_razonamiento") // effort (solo gpt-5*)
  createdAt       DateTime @default(now()) @map("creado_en")
  updatedAt       DateTime @updatedAt @map("actualizado_en")

  @@index([createdAt])
  @@map("estudio_mercado")
}

// ── Canales de mensajería (Telegram / WhatsApp) ──────────────────────────────

model ChannelConnection {
  id            String   @id @default(cuid())
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId       String   @map("agente_id")
  provider      String   @map("proveedor") // telegram | whatsapp
  credentials   Json     @map("credenciales") // ciphertext AES-256-GCM: { iv, authTag, data } — NUNCA texto plano
  status        String   @default("pending") @map("estado") // pending | active | error
  statusDetail  String?  @map("detalle_estado") // detalle del error si status=error
  webhookSecret String?  @map("webhook_secret") // Telegram: secret_token del setWebhook (≥32 bytes hex)
  botUsername   String?  @map("bot_username") // Telegram: nombre de usuario del bot (para mostrar en UI)
  botName       String?  @map("bot_nombre") // Telegram: nombre del bot
  metadata      Json     @default("{}") @map("metadata") // F2 aa-openclaw-brain: { managedBy?: "openclaw" } — si managedBy="openclaw" AA NUNCA registra webhook (OpenClaw hace polling; ver lib/openclaw/provision.ts)
  createdAt     DateTime @default(now()) @map("creado_en")
  updatedAt     DateTime @updatedAt @map("actualizado_en")

  @@unique([agentId, provider])
  @@map("conexion_canal")
}

// ── Booking / Disponibilidad ─────────────────────────────────────────────────

/// Unidad finita de inventario que una reserva ocupa: mesa de restaurante, barbero,
/// cabina de estética. Los tres verticales son el MISMO problema — una reserva ocupa un
/// recurso elegible durante `[llegada, llegada + duracion + buffer)` — y `kind` existe
/// solo para que la UI y el agente usen la palabra correcta.
///
/// `kind` NO debe ramificar el algoritmo de disponibilidad. En cuanto lo haga, los tres
/// verticales vuelven a bifurcarse y cada uno arrastra su propio juego de bugs.
model Resource {
  id          String            @id @default(cuid())
  agent       Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId     String            @map("agente_id")
  name        String            @map("nombre") // "Mesa 4", "Javi", "Cabina Láser"
  kind        String            @default("room") @map("tipo") // table | staff | room
  // Rango de aforo. Un grupo es elegible para el recurso si capacityMin <= grupo <= capacityMax.
  // Por defecto 1..1 para que un agente migrado desde el modelo anterior se comporte igual.
  capacityMin Int               @default(1) @map("capacidad_min")
  capacityMax Int               @default(1) @map("capacidad_max")
  zone        String?           @map("zona") // "Sala", "Terraza", "Planta 1"
  enabled     Boolean           @default(true) @map("activo")
  services    ServiceResource[]
  slots       TimeSlot[]
  createdAt   DateTime          @default(now()) @map("creado_en")

  @@unique([agentId, name])
  @@index([agentId, enabled])
  @@map("recurso")
}

/// Qué recursos pueden servir qué servicio: el barbero que no hace barbas, la cabina sin
/// láser, la terraza cerrada al brunch.
///
/// Conjunto VACÍO significa "todos los recursos habilitados del agente". Esa es la regla
/// que hace que la migración no cambie el comportamiento de nadie: los servicios que ya
/// existen no tienen ninguna fila aquí.
model ServiceResource {
  serviceId  String   @map("servicio_id")
  resourceId String   @map("recurso_id")
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([serviceId, resourceId])
  @@index([resourceId])
  @@map("servicio_recurso")
}

model Service {
  id           String            @id @default(cuid())
  agent        Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId      String            @map("agente_id")
  name         String            @map("nombre") // "Consulta 30 min", "Demo 1h"
  duration     Int               @map("duracion") // duración en minutos
  description  String?           @map("descripcion")
  enabled      Boolean           @default(true) @map("activo")
  // Granularidad de llegada en minutos. Sustituye al `minute += 30` que estaba escrito a
  // fuego en `generateSlots`; un restaurante toma reservas cada 15.
  slotStepMin  Int               @default(30) @map("paso_minutos")
  // Margen de rotación tras el servicio: limpieza de mesa, reseteo de cabina. Se suma a la
  // ocupación del recurso, NO a lo que se le ofrece al cliente.
  bufferMin    Int               @default(0) @map("buffer_minutos")
  // Tope de grupo del canal automático. Por encima se deriva al canal de grupos y eventos,
  // que es exactamente lo que hace un restaurante real.
  maxPartySize Int               @default(1) @map("max_comensales")
  // Turno propio del servicio, misma gramática que `AgentSchedule.schedule` (incluido el
  // `|` de descanso partido). Cuando está presente MANDA sobre el horario del agente.
  //
  // Existe porque los turnos son del servicio y no del día: la comida y la cena de un
  // restaurante son dos ventanas distintas, y el domingo puede haber brunch y comida pero
  // no cena. Con un solo horario por agente eso es inexpresable.
  schedule     Json?             @map("horario")
  slots        TimeSlot[]
  appointments Appointment[]
  resources    ServiceResource[]
  createdAt    DateTime          @default(now()) @map("creado_en")
  updatedAt    DateTime          @updatedAt @map("actualizado_en")

  @@unique([agentId, name])
  @@index([agentId])
  @@map("servicio_agente")
}

/// Ocupación de UN recurso durante un intervalo. `fin` incluye ya el `bufferMin` del
/// servicio: es cuándo el recurso vuelve a estar libre, no cuándo se va el cliente.
model TimeSlot {
  id           String       @id @default(cuid())
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId    String       @map("servicio_id")
  resource     Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceId   String       @map("recurso_id")
  startTime    DateTime     @map("inicio") // fecha + hora (ej 2026-06-20 14:30)
  endTime      DateTime     @map("fin") // fecha + hora (ej 2026-06-20 15:00)
  available    Boolean      @default(true) @map("disponible")
  appointment  Appointment?
  syncedToGcal String?      @map("sincronizado_gcal") // Google Calendar event ID si sincronizado
  createdAt    DateTime     @default(now()) @map("creado_en")

  // El unique pasa de (servicio, inicio) a (recurso, inicio). Ese cambio ES lo que convierte
  // "una reserva por servicio e instante" en "una por mesa e instante": con el anterior, un
  // restaurante de doce mesas aceptaba UNA reserva a las 21:00.
  //
  // Sigue siendo la última defensa contra la doble reserva concurrente: dos transacciones
  // Serializable que elijan la misma mesa chocan en P2002 y la perdedora sale como
  // SlotUnavailableError.
  @@unique([resourceId, startTime])
  @@index([serviceId, available])
  @@index([resourceId, startTime, endTime])
  @@index([startTime])
  @@map("franja_horaria")
}

model AgentSchedule {
  id        String         @id @default(cuid())
  agent     Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String         @unique @map("agente_id")
  timezone  String         @default("Europe/Madrid") @map("zona_horaria")
  // schedule = { mon: "09:00-18:00", tue: "09:00-18:00", ... }
  // o { mon: "09:00-13:00|14:00-18:00" } para descansos
  schedule  Json           @default("{}") @map("horario")
  blocked   BlockedRange[]
  createdAt DateTime       @default(now()) @map("creado_en")
  updatedAt DateTime       @updatedAt @map("actualizado_en")

  @@map("horario_agente")
}

model BlockedRange {
  id         String        @id @default(cuid())
  schedule   AgentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduleId String        @map("horario_id")
  startDate  DateTime      @map("fecha_inicio") // fecha inicio (sin hora, mediodía)
  endDate    DateTime      @map("fecha_fin") // fecha fin (sin hora, mediodía)
  reason     String?       @map("motivo") // "Vacaciones", "Cierre", etc.
  createdAt  DateTime      @default(now()) @map("creado_en")

  @@index([scheduleId, startDate])
  @@map("rango_bloqueo")
}

model Appointment {
  id          String    @id @default(cuid())
  // Nullable a propósito: al cancelar se BORRA la franja para liberar el instante. Antes se
  // marcaba `disponible=true` y la fila se quedaba, así que el hueco se volvía a ofrecer y
  // el siguiente INSERT chocaba con el unique — un hueco cancelado no se podía volver a
  // reservar NUNCA. `slotId = null` es la representación honesta de "esta reserva ya no
  // retiene inventario"; el rastro (estado, fechas, gcalEventId) vive en esta tabla.
  slot        TimeSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  slotId      String?   @unique @map("franja_id")
  // La reserva guarda SU horario, no lo lee de la franja. La franja es inventario y se borra
  // al cancelar; si la fecha viviera solo allí, una cita cancelada perdería la fecha y el
  // negocio no podría saber qué se canceló ni cuándo.
  startTime   DateTime  @map("inicio")
  endTime     DateTime  @map("fin")
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceId   String    @map("servicio_id")
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId      String?   @map("lead_id")
  email       String? // email del lead/cliente si no vinculado
  phone       String?   @map("telefono") // teléfono del lead/cliente
  // Tamaño del grupo. Decide qué recursos son elegibles: sin esto, "mesa para 4" no es
  // expresable y ninguna mesa puede casarse con ningún grupo.
  partySize   Int       @default(1) @map("comensales")
  customerName String?  @map("nombre_cliente")
  // Código corto que el cliente puede repetir por chat ("LAF-7K2Q"). Es lo que hace posible
  // cancelar desde el bot: el huésped no tiene cuenta ni conoce el cuid.
  //
  // Nunca basta por sí solo para cancelar — cuatro caracteres se adivinan a escala. La
  // cancelación exige además un contacto que coincida (ver lib/booking/cancel.ts).
  confirmationCode String? @unique @map("codigo_confirmacion")
  notes       String?   @map("notas") // notas de la cita
  status      String    @default("scheduled") @map("estado") // scheduled | attended | cancelled | no-show
  gcalEventId String?   @map("gcal_event_id") // Google Calendar event ID
  createdAt   DateTime  @default(now()) @map("creado_en")
  updatedAt   DateTime  @updatedAt @map("actualizado_en")

  @@index([slotId])
  @@index([leadId])
  @@index([createdAt])
  @@index([serviceId, status])
  @@index([startTime])
  @@map("cita")
}

/// Eventos de webhook de Stripe ya vistos (H6 aa-stripe-suscripciones, T1 · design §D5).
///
/// Existe por una sola razón: Stripe reintenta hasta recibir un 2xx y puede entregar el mismo evento
/// más de una vez incluso después de un 200. Procesar dos veces un `invoice.paid` renovaría dos
/// periodos de cupo por un solo cobro.
///
/// La `id` es el `event.id` de Stripe, sin `@default`: la clave la pone el emisor, no nosotros. El
/// unique de esta columna es la ÚNICA primitiva de exclusión disponible aquí, y de ahí el orden
/// obligatorio del manejador: `create()` ANTES de procesar. Al revés (procesar y luego registrar) no
/// sirve, porque dos entregas concurrentes pasarían las dos el "¿ya existe?" antes de que ninguna
/// hubiera registrado nada.
///
/// `processedAt` nullable no es decorativo: distingue "visto pero sin terminar" de "ya hecho". Un
/// evento que falló al procesar se queda con `processedAt = null` y su reentrega SÍ se vuelve a
/// procesar; uno con fecha se descarta. Sin esa distinción, el primer fallo transitorio dejaría el
/// evento registrado y perdido para siempre.
model StripeEvent {
  id          String    @id // el event.id de Stripe (evt_...). No se genera aquí.
  type        String    @map("tipo") // invoice.paid, customer.subscription.updated, ...
  receivedAt  DateTime  @default(now()) @map("recibido_en")
  processedAt DateTime? @map("procesado_en") // null = visto, no terminado ⇒ reintentable
  error       String?   @map("error") // último fallo, para diagnóstico

  @@index([type, receivedAt])
  @@map("stripe_evento")
}

/// Mapa servicio del catálogo → `Product`/`Price` de Stripe (H6, T1 · design §D2).
///
/// `serviceId` es el `id` de `front/lib/service-catalog.json`, que es también `Plan.codigo`: un solo
/// identificador recorre catálogo → plan → Stripe, sin tabla de traducción que mantener.
///
/// No vive en `Plan` a propósito, y el motivo es operativo: los ids de Stripe son DISTINTOS en `test`
/// y en `live`. En `Plan` habría que duplicar cada plan por entorno, o aceptar que un despliegue de
/// pruebas pisara los ids de producción. Con `mode` en la clave los dos entornos conviven, y `Plan`
/// sigue sin saber nada de Stripe.
///
/// `amount` es un ESPEJO del catálogo en céntimos, no una segunda fuente: existe para que el tripwire
/// `stripe:check` pueda detectar deriva sin llamar a la API por cada servicio. La fuente sigue siendo
/// el JSON del catálogo.
///
/// `priceId` es el `Price` VIGENTE. Los `Price` de Stripe son inmutables: subir 99 € a 109 € no edita
/// nada, crea un `Price` nuevo. `stripe:sync` lo crea, lo marca aquí, archiva el anterior y deja
/// intactas las suscripciones ya firmadas — migrarlas es una decisión comercial, no la consecuencia
/// automática de editar un JSON.
model StripePriceMap {
  serviceId String   @map("servicio_id") // = catálogo.id = Plan.codigo
  mode      String   @map("modo") // test | live
  productId String   @map("producto_id")
  priceId   String   @map("precio_id") // Price vigente (los anteriores quedan archivados en Stripe)
  amount    Int      @map("importe_centimos") // espejo del catálogo, para el tripwire de deriva
  currency  String   @default("eur") @map("moneda")
  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @default(now()) @updatedAt @map("actualizado_en")

  @@id([serviceId, mode])
  @@unique([priceId])
  @@map("stripe_precio_mapa")
}
