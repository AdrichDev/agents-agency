generator client {
  provider        = "prisma-client"
  output          = "../src/lib/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

/// Usuarios del SaaS (login de la landing y el dashboard)
model User {
  id           String   @id @default(cuid())
  firstName    String                    // nombre
  lastName     String                    // apellido
  email        String   @unique
  passwordHash String                    // bcrypt, nunca en texto plano
  role         String   @default("admin") // admin | editor | viewer
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Leads captados por el formulario de la landing pública
model LandingLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  message   String?                   // Mensaje / comentario voluntario del lead
  consent   Boolean  @default(false) // "He leído y acepto..."
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Client {
  id             String    @id @default(cuid())
  codCliente     String?   @unique             // Código de negocio secuencial: cli-01, cli-02...
  name           String                        // Nombre o razón social
  razonSocial    String?                       // Razón social (si difiere del nombre)
  cif            String?                       // NIF / CIF
  address        String?                       // Dirección
  direccion      String?                       // Dirección (campo de negocio solicitado)
  email          String?
  phone          String?
  contactPerson  String?                       // Persona de contacto
  website        String?
  sector         String?
  // Créditos de IA: el widget del cliente consume tokens de la cuenta OpenAI del propietario.
  // tokenBalance = cupo asignado; tokensUsed = consumo acumulado; isActive=false bloquea el chat.
  tokenBalance   Int       @default(0)           // cupo de tokens asignado (0 = bloqueado)
  tokensUsed     Int       @default(0)           // consumo acumulado de tokens
  isActive       Boolean   @default(true)        // false → widget devuelve 402
  agents         Agent[]
  budgets        Budget[]
  prospectContacts ProspectContact[]           // Contactos (leads/prospectos) vinculados o convertidos
  tokenUsage     TokenUsage[]                  // log de consumo por conversación
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
}

/// Log de consumo de tokens por conversación (auditoría y facturación manual).
model TokenUsage {
  id             String   @id @default(cuid())
  clientId       String
  agentId        String
  conversationId String
  tokens         Int
  model          String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([clientId, createdAt])
}

/// Tipo de contacto comercial
enum ContactType {
  lead
  prospecto
}

/// Estado de contacto: sí / no / no contesta (nc)
enum ContactedStatus {
  si
  no
  nc
}

/// Contactos comerciales (leads y prospectos) — agenda de llamadas
model ProspectContact {
  id          String          @id @default(cuid())
  codigo      String          @unique            // Código de negocio secuencial: pc-01, pc-02...
  type        ContactType     @default(prospecto)
  name        String
  phone       String?
  email       String?
  sector      String?
  direccion   String?
  peticion    String?                            // Mensaje voluntario heredado del lead (o nota manual)
  contactado  ContactedStatus @default(no)
  contactedAt DateTime?                          // Fecha en la que se marcó como contactado
  client      Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId    String?                            // Cliente al que se convirtió este contacto
  createdAt   DateTime        @default(now())    // Fecha y hora de inclusión
  deletedAt   DateTime?                          // Soft delete: si está sellada, el contacto se oculta de los listados

  @@index([type, contactado])
  @@index([createdAt])
  @@index([deletedAt])
}

model Agent {
  id            String           @id @default(cuid())
  name          String
  sector        String
  systemPrompt  String
  model         String           @default("gpt-4.1-nano")
  reasoningEffort String          @default("low") // minimal | low | medium | high (solo gpt-5*)
  temperature   Float            @default(0.7)
  channel       String           @default("widget") // widget | api | telegram | whatsapp
  widgetPrimaryColor   String    @default("#4f46e5")
  widgetSecondaryColor String    @default("#9333ea")
  widgetAvatarBase64   String?
  widgetAvatarEmoji    String    @default("🤖")
  widgetTemplateConfig Json      @default("{}")
  ecommerceConfig      Json      @default("{}")
  publicKey     String           @unique @default(cuid())
  client        Client?          @relation(fields: [clientId], references: [id])
  clientId      String?
  knowledge     KnowledgeChunk[]
  skills        AgentSkill[]
  integrations  Integration[]
  automations   Automation[]
  conversations      Conversation[]
  leads              Lead[]
  channelConnections ChannelConnection[]
  services           Service[]         // Servicios reservables (consultas, demos)
  schedule           AgentSchedule?    // Horario disponible
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model KnowledgeChunk {
  id        String                      @id @default(cuid())
  agent     Agent                       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String
  source    String // URL o nombre de documento
  content   String
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                    @default(now())

  @@index([agentId])
}

/// Tipo de herramienta — solo 5 valores permitidos
enum SkillType {
  SKILL
  AGENT
  EXTENSION
  PLUGIN
  MCP
}

model Skill {
  id          String       @id @default(cuid())
  name        String       @unique
  description String
  type        SkillType    @default(SKILL)
  use         String       @default("GENERAL") // uso funcional en UPPERCASE (EMAIL, DESARROLLO, ...)
  repoUrl     String?
  stars       Int          @default(0)
  tools       Json         @default("[]") // [{name, description}]
  source      String       @default("github") // github | builtin
  favorite    Boolean      @default(false)
  agents      AgentSkill[]
  createdAt   DateTime     @default(now())
}

model AgentSkill {
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId String

  @@id([agentId, skillId])
}

model Integration {
  id           String    @id @default(cuid())
  agent        Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId      String
  provider     String // google | slack | notion | jira | instagram
  accessToken  String    // cifrado enc:v1:<base64>
  refreshToken String?   // cifrado enc:v1:<base64> o null
  expiresAt    DateTime?
  status       String    @default("connected") // connected | reauth_required
  metadata     Json      @default("{}") // email Google, team Slack, workspace Notion, cloudId Jira
  createdAt    DateTime  @default(now())

  @@unique([agentId, provider])
}

model Automation {
  id        String          @id @default(cuid())
  agent     Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String
  name      String
  trigger   String // new_email | new_slack_message | schedule
  // instrucciÃ³n en lenguaje natural que ejecuta el agente, p.ej.
  // "Si el email es urgente crea un ticket en Jira y avisa por Slack"
  prompt    String
  // configuracion estructurada: { service, action, intervalMinutes }
  // base para generar workflows en n8n (jobs programados o webhooks)
  config    Json            @default("{}")
  enabled       Boolean         @default(true)
  lastRunAt     DateTime?
  n8nWorkflowId String?
  syncStatus    String          @default("pending") // synced | pending | error
  runs          AutomationRun[]
  createdAt     DateTime        @default(now())
}

model AutomationRun {
  id           String     @id @default(cuid())
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId String
  status       String // ok | error | skipped
  summary      String?
  toolCalls    Json       @default("[]")
  createdAt    DateTime   @default(now())

  @@index([automationId, createdAt])
}

model Conversation {
  id        String    @id @default(cuid())
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String
  channel   String    @default("widget")
  metadata  Json      @default("{}")
  messages  Message[]
  lead      Lead?
  createdAt DateTime  @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  role           String // user | assistant
  content        String
  toolCalls      Json         @default("[]")
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Sector {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Lead {
  id             String        @id @default(cuid())
  agent          Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId        String
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  conversationId String?       @unique
  customerName   String
  email          String?
  phone          String?
  consent        Boolean       @default(false)
  status         String        @default("new")
  appointments   Appointment[] // Citas agendadas
  createdAt      DateTime      @default(now())

  @@index([agentId, createdAt])
}

model SystemConfig {
  id             String   @id @default("default")
  theme          String   @default("dark")
  primaryColor   String   @default("#6366f1")
  secondaryColor String   @default("#d946ef")
  fontFamily     String   @default("ui-sans-serif, system-ui, -apple-system, sans-serif")
  favicon        String?  // Almacenará la imagen en formato base64
  sidebarLogo    String?  // Almacenará el logotipo en formato base64
  sidebarBg      String?  @default("#05050A")
  pageBg         String?  @default("#030308")
  sidebarBgLight String?  @default("#ffffff")
  pageBgLight    String?  @default("#f8fafc")
  adminEmail     String?  // Destinatario de las notificaciones de nuevos leads
  defaultAgentModel String @default("gpt-4.1-nano") // modelo por defecto para nuevos agentes
  reasoningEffort   String @default("low")          // effort global por defecto (gpt-5*)
  googleClientId     String? // OAuth Google (admin) — id, no secreto
  googleClientSecret String? // OAuth Google (admin) — cifrado
  updatedAt      DateTime @updatedAt
}

// ── Presupuestos ──────────────────────────────────────────────────────────────

model Budget {
  id             String       @id @default(cuid())
  quoteNumber    String       @unique           // Nº Presupuesto, ej. AD-2026-001
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId       String?
  clientSnapshot Json         @default("{}")    // Snapshot del cliente en el momento de generar
  issuerSnapshot Json         @default("{}")    // Snapshot del emisor (datos fiscales)
  status         String       @default("draft") // draft | sent | accepted | rejected
  subtotalImpl   Float        @default(0)       // Base pago único
  subtotalMaint  Float        @default(0)       // Base mensual
  vatRate        Float        @default(0.21)
  totalImpl      Float        @default(0)       // Con IVA
  totalMaint     Float        @default(0)       // Con IVA
  validDays      Int          @default(30)      // Días de validez
  notes          String?
  lines          BudgetLine[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([clientId, createdAt])
}

model BudgetLine {
  id          String  @id @default(cuid())
  budget      Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetId    String
  serviceId   String                  // id del servicio del catálogo
  name        String
  description String?
  quantity    Int     @default(1)
  implPrice   Float   @default(0)    // Precio puesta en marcha por unidad
  maintPrice  Float   @default(0)    // Precio mensual por unidad
  position    Int     @default(0)    // Orden en la tabla

  @@index([budgetId])
}

// ── Landing Builder ──────────────────────────────────────────────────────────

model LandingProject {
  id               String   @id @default(cuid())
  name             String
  business         String?
  answers          Json     @default("{}")
  chatMessages     Json     @default("[]")      // [{role: user|assistant, content: string}]
  generationPrompt String?
  dbProvider       String   @default("none")   // none | local-postgres | firebase | supabase
  files            Json     @default("{}")      // { path → content }
  mobileFiles      Json     @default("{}")      // { path → content }
  mobileStack      String?                      // expo | flutter
  qrUrl            String?                      // URL editable a la que apunta el QR
  status           String   @default("draft")   // draft | generated
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([updatedAt])
}

// ── Estudios de Mercado ───────────────────────────────────────────────────────

model MarketStudy {
  id           String   @id @default(cuid())
  title        String
  inputs       Json     @default("{}")
  sections     Json     @default("[]")
  prospects    Json     @default("[]")
  status       String   @default("draft")  // draft | generating | ready | error
  successScore Int?                         // 1-5, null until generated or set
  model        String   @default("gpt-4.1-nano") // modelo LLM para generar el estudio
  reasoningEffort String @default("low")         // effort (solo gpt-5*)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

// ── Canales de mensajería (Telegram / WhatsApp) ──────────────────────────────

model ChannelConnection {
  id            String   @id @default(cuid())
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId       String
  provider      String   // telegram | whatsapp
  credentials   Json     // ciphertext AES-256-GCM: { iv, authTag, data } — NUNCA texto plano
  status        String   @default("pending") // pending | active | error
  statusDetail  String?  // detalle del error si status=error
  webhookSecret String?  // Telegram: secret_token del setWebhook (≥32 bytes hex)
  botUsername   String?  // Telegram: nombre de usuario del bot (para mostrar en UI)
  botName       String?  // Telegram: nombre del bot
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([agentId, provider])
}

// ── Booking / Disponibilidad ─────────────────────────────────────────────────

model Service {
  id          String    @id @default(cuid())
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId     String
  name        String    // "Consulta 30 min", "Demo 1h"
  duration    Int       // duración en minutos
  description String?
  enabled     Boolean   @default(true)
  slots       TimeSlot[]
  appointments Appointment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([agentId, name])
  @@index([agentId])
}

model TimeSlot {
  id          String      @id @default(cuid())
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId   String
  startTime   DateTime    // fecha + hora (ej 2026-06-20 14:30)
  endTime     DateTime    // fecha + hora (ej 2026-06-20 15:00)
  available   Boolean     @default(true)
  appointment Appointment?
  syncedToGcal String?    // Google Calendar event ID si sincronizado
  createdAt   DateTime    @default(now())

  @@unique([serviceId, startTime])
  @@index([serviceId, available])
  @@index([startTime])
}

model AgentSchedule {
  id        String   @id @default(cuid())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId   String   @unique
  timezone  String   @default("Europe/Madrid")
  // schedule = { mon: "09:00-18:00", tue: "09:00-18:00", ... }
  // o { mon: "09:00-13:00|14:00-18:00" } para descansos
  schedule  Json     @default("{}")
  blocked   BlockedRange[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlockedRange {
  id        String   @id @default(cuid())
  schedule  AgentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  scheduleId String
  startDate DateTime  // fecha inicio (sin hora, mediodía)
  endDate   DateTime  // fecha fin (sin hora, mediodía)
  reason    String?   // "Vacaciones", "Cierre", etc.
  createdAt DateTime  @default(now())

  @@index([scheduleId, startDate])
}

model Appointment {
  id          String      @id @default(cuid())
  slot        TimeSlot    @relation(fields: [slotId], references: [id], onDelete: Restrict)
  slotId      String      @unique
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceId   String
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId      String?
  email       String?     // email del lead/cliente si no vinculado
  phone       String?     // teléfono del lead/cliente
  notes       String?     // notas de la cita
  status      String      @default("scheduled") // scheduled | attended | cancelled | no-show
  gcalEventId String?     // Google Calendar event ID
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([slotId])
  @@index([leadId])
  @@index([createdAt])
}


