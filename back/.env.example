# ── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5433/3AStudioDB"

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=4000
FRONT_URL=http://localhost:3000

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── OAuth (Integraciones) ────────────────────────────────────────────────────
BACK_URL=http://localhost:4000

# Google (unificado: Calendar + Gmail en un solo proveedor)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Notion (nuevo en P2)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Jira (fase posterior — "Próximamente" en la UI)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Instagram (fase posterior — solo UI "Próximamente", no requiere credenciales aún)

# ── Canales de mensajería (Telegram / WhatsApp) ───────────────────────────────

# Clave AES-256 para cifrar credenciales de canales en reposo.
# Formato: 64 caracteres hexadecimales (= 32 bytes).
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ADVERTENCIA: cambiar esta clave invalida TODAS las credenciales de canales existentes.
# Si la rotas, debes reconectar todos los bots (Telegram y WhatsApp).
CHANNEL_ENCRYPTION_KEY=

# URL HTTPS pública del backend, accesible desde internet.
# Requerida para registrar webhooks de Telegram y WhatsApp.
# En desarrollo local: usar ngrok (ngrok http 4000) o cloudflared.
# En producción: URL del servidor desplegado, sin barra final.
# Ejemplo: https://api.midominio.com
PUBLIC_URL=

# App Secret de Meta (opcional pero recomendado en producción).
# Si está definido, se valida la firma X-Hub-Signature-256 de los webhooks de WhatsApp.
# Obtener en: Meta Developer Console → App → Settings → Basic → App Secret
META_APP_SECRET=

# Versión de la Graph API de Meta. Default: v21.0
META_GRAPH_VERSION=v21.0

# ── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=

# ── n8n (opcional — sin estas vars el cron interno cubre todas las automations) ──
# URL base de n8n, ej. http://localhost:5678
# En Docker con backend en host: http://host.docker.internal:4000
N8N_BASE_URL=

# API key generada en n8n: Settings → n8n API → Create an API key
N8N_API_KEY=

# Secreto compartido para autenticar POST /api/automations/:id/execute desde n8n.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADVERTENCIA: rotar este secreto exige re-sync de todos los workflows en n8n.
AUTOMATION_WEBHOOK_SECRET=
